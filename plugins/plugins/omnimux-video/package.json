{
  "name": "omnimux-video",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnimux-ai/omnimux-client.git",
    "directory": "plugins/plugins/omnimux-video"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "skills",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test 'src/**/*.test.js'",
    "prepublishOnly": "node ../../scripts/verify-publish-source.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "Process videos, extract depth maps, and analyze content locally with FFmpeg."
}
