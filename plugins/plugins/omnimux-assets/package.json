{
  "name": "omnimux-assets",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnimux-ai/omnimux-client.git",
    "directory": "plugins/plugins/omnimux-assets"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "cloud-catalog",
    "scripts/build-client.mjs",
    "scripts/build-cloud-assets-catalog.mjs",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:cloud-catalog": "node scripts/build-cloud-assets-catalog.mjs",
    "prepare": "npm run build",
    "test": "node --test $(ls src/*.test.js | grep -v cloud-catalog-build.test.js) src/client/*.test.js tests/e2e/*.spec.js",
    "prepublishOnly": "node ../../scripts/verify-publish-source.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "dsh-ui-kit": "^0.1.0",
    "omnimux-products": "^0.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 || >=0.2.1-rc.3 <0.3.0-0 || >=0.2.2-rc.5 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "Manage reusable characters, scenes, styles, and generated media."
}
